# Copy to .env.local (git-ignored) and paste a PUBLIC Mapbox token (starts with "pk.").
# Create one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_PUBLIC_ACCESS=

# Server-side only (no VITE_ prefix, so it is never sent to the browser).
# Used by the CopilotKit chat runtime. In Vercel, add it under Environment Variables.
OPENAI_API_KEY=
